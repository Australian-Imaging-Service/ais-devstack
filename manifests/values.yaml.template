# XNAT Helm Chart Values for k3s deployment
# Update the ingress host and OpenID settings for your environment
global:
  postgresql:
    auth:
      database: xnat
      username: xnat
      password: xnat

postgresql:
  image:
    repository: bitnamilegacy/postgresql

xnat-web:
  postgresql:
    postgresqlDatabase: xnat
    postgresqlUsername: xnat
    postgresqlPassword: xnat

  replicaCount: 1

  ingress:
    enabled: true
    annotations:
      cert-manager.io/cluster-issuer: letsencrypt-prod
      nginx.ingress.kubernetes.io/proxy-body-size: 12g
      nginx.ingress.kubernetes.io/proxy-buffer-size: 32k
      nginx.ingress.kubernetes.io/proxy-buffering: "off"
      nginx.ingress.kubernetes.io/proxy-buffers-number: "4"
      nginx.ingress.kubernetes.io/proxy-connect-timeout: "150"
      nginx.ingress.kubernetes.io/proxy-read-timeout: "600"
      nginx.ingress.kubernetes.io/proxy-send-timeout: "600"
    ingressClassName: nginx
    hosts:
      - host: xnat-test.ssdsorg.cloud.edu.au
    tls:
      - secretName: xnat-tls
        hosts:
          - xnat-test.ssdsorg.cloud.edu.au

  resources:
    requests:
      cpu: "2"
      memory: 4096Mi
    limits:
      cpu: "2"
      memory: 4096Mi

  nonheapmem: 3096Mi

  persistence:
    cache:
      accessMode: ReadWriteOnce
      mountPath: "/data/xnat/cache"
      size: 1Gi

  volumes:
    archive:
      accessMode: ReadWriteMany
      existingClaim: "pv-xnat-gpfs"
      mountPath: "/data/xnat/archive"
    prearchive:
      accessMode: ReadWriteMany
      existingClaim: "pv-xnat-nfs"
      mountPath: "/data/xnat/prearchive"

  plugins:
    container-service: []
    ohif-viewer: {}
    openid-auth-plugin:
      - name: "OpenID Authentication Provider"
        provider:
          id: stanford
        auth:
          method: openid
        auto:
          enabled: true
          verified: true
        visible: true
        disableUsernamePasswordLogin: true
        enabled: "stanford"
        preEstablishedRedirUri: "/openid-login"
        siteUrl: "https://xnat-test.ssdsorg.cloud.edu.au"
        type: openid
        openid:
          stanford:
            pkceEnabled: true
            usernamePattern: "[email_prefix]"
            accessTokenUri: https://login.stanford.edu/idp/profile/oidc/token
            userAuthUri: https://login.stanford.edu/idp/profile/oidc/authorize
            userInfoUri: https://login.stanford.edu/idp/profile/oidc/userinfo
            clientId: "w-8e73882581ab1d"
            clientSecret: "8QxdGkgA7rX26ZFC9y4FKYr6nhNzHSWgZBz7"
            scopes: "openid,profile,email"
            link: '<p>To sign-in using your Stanford credentials, please click on the button below.</p><p><a href="/openid-login?providerId=stanford">Login with Stanford (SUNet ID)</a></p>'
            shouldFilterEmailDomains: false
            allowedEmailDomains: "stanford.edu"
            forceUserCreate: true
            userAutoEnabled: true
            userAutoVerified: true
            emailProperty: email
            givenNameProperty: given_name
            familyNameProperty: family_name

  probes:
    startup:
      failureThreshold: 30
      periodSeconds: 20
    liveness:
      periodSeconds: 20
    readiness:
      periodSeconds: 20

  timezone: America/Los_Angeles
