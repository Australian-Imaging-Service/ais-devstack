# XNAT Helm Chart Values for k3s deployment
# Configured for Google OIDC authentication
global:
  postgresql:
    auth:
      database: xnat
      username: xnat
      password: CHANGE_ME

postgresql:
  image:
    repository: bitnamilegacy/postgresql

xnat-web:
  postgresql:
    postgresqlDatabase: xnat
    postgresqlUsername: xnat
    postgresqlPassword: CHANGE_ME

  replicaCount: 1

  ingress:
    enabled: true
    annotations:
      nginx.ingress.kubernetes.io/proxy-body-size: 12g
      nginx.ingress.kubernetes.io/proxy-buffer-size: 32k
      nginx.ingress.kubernetes.io/proxy-buffering: "off"
      nginx.ingress.kubernetes.io/proxy-buffers-number: "4"
      nginx.ingress.kubernetes.io/proxy-connect-timeout: "150"
      nginx.ingress.kubernetes.io/proxy-read-timeout: "600"
      nginx.ingress.kubernetes.io/proxy-send-timeout: "600"
    ingressClassName: nginx
    hosts:
      - host: YOUR_DOMAIN

  resources:
    requests:
      cpu: 1000m
      memory: 2000Mi
    limits:
      cpu: 1000m
      memory: 2000Mi

  nonheapmem: 1000Mi

  persistence:
    cache:
      accessMode: ReadWriteOnce
      mountPath: "/data/xnat/cache"
      size: 1Gi

  volumes:
    archive:
      accessMode: ReadWriteMany
      existingClaim: "pv-xnat-gpfs"
      mountPath: "/data/xnat/archive"
    prearchive:
      accessMode: ReadWriteMany
      existingClaim: "pv-xnat-nfs"
      mountPath: "/data/xnat/prearchive"

  plugins:
    container-service: []
    ohif-viewer: {}
    openid-auth-plugin:
      - name: "Google Authentication"
        provider:
          id: google
        auth:
          method: openid
        auto:
          enabled: true
          verified: true
        visible: true
        disableUsernamePasswordLogin: false
        enabled: "google"
        preEstablishedRedirUri: "/openid-login"
        siteUrl: "https://YOUR_DOMAIN"
        type: openid
        openid:
          google:
            accessTokenUri: https://oauth2.googleapis.com/token
            userAuthUri: https://accounts.google.com/o/oauth2/v2/auth
            clientId: "YOUR_GOOGLE_CLIENT_ID"
            clientSecret: "YOUR_GOOGLE_CLIENT_SECRET"
            scopes: "openid,profile,email"
            link: '<p>To sign-in using your Google account, please click on the button below.</p><p><a href="/openid-login?providerId=google">Sign in with Google</a></p>'
            shouldFilterEmailDomains: true
            allowedEmailDomains: "YOUR_EMAIL_DOMAIN"
            forceUserCreate: true
            userAutoEnabled: true
            userAutoVerified: true
            emailProperty: email
            givenNameProperty: given_name
            familyNameProperty: family_name

  probes:
    startup:
      failureThreshold: 30
      periodSeconds: 20
    liveness:
      periodSeconds: 20
    readiness:
      periodSeconds: 20

  timezone: Australia/Brisbane
