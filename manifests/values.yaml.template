# XNAT Helm Chart Values for k3s deployment
# Update the ingress host and OpenID settings for your environment
global:
  postgresql:
    auth:
      database: xnat
      username: xnat
      password: xnat

postgresql:
  image:
    repository: bitnamilegacy/postgresql

xnat-web:
  postgresql:
    postgresqlDatabase: xnat
    postgresqlUsername: xnat
    postgresqlPassword: xnat

  replicaCount: 1

  ingress:
    enabled: true
    annotations:
      nginx.ingress.kubernetes.io/proxy-body-size: 12g
      nginx.ingress.kubernetes.io/proxy-buffer-size: 32k
      nginx.ingress.kubernetes.io/proxy-buffering: "off"
      nginx.ingress.kubernetes.io/proxy-buffers-number: "4"
      nginx.ingress.kubernetes.io/proxy-connect-timeout: "150"
      nginx.ingress.kubernetes.io/proxy-read-timeout: "600"
      nginx.ingress.kubernetes.io/proxy-send-timeout: "600"
    ingressClassName: nginx
    hosts:
      - host: xnat-test.ssdsorg.cloud.edu.au

  resources:
    requests:
      cpu: 1000m
      memory: 2000Mi
    limits:
      cpu: 1000m
      memory: 2000Mi

  nonheapmem: 1000Mi

  persistence:
    cache:
      accessMode: ReadWriteOnce
      mountPath: "/data/xnat/cache"
      size: 1Gi

  volumes:
    archive:
      accessMode: ReadWriteMany
      existingClaim: "pv-xnat-gpfs"
      mountPath: "/data/xnat/archive"
    prearchive:
      accessMode: ReadWriteMany
      existingClaim: "pv-xnat-nfs"
      mountPath: "/data/xnat/prearchive"

  plugins:
    container-service: []
    ohif-viewer: {}
    openid-auth-plugin:
      - name: "OpenID Authentication Provider"
        provider:
          id: aaf
        auth:
          method: openid
        auto:
          enabled: true
          verified: true
        visible: true
        disableUsernamePasswordLogin: false
        enabled: "aaf"
        preEstablishedRedirUri: "/openid-login"
        siteUrl: "http://xnat-test.ssdsorg.cloud.edu.au"
        type: openid
        openid:
          aaf:
            accessTokenUri: https://central.test.aaf.edu.au/providers/op/token
            userAuthUri: https://central.test.aaf.edu.au/providers/op/authorize
            clientId: "d93e2fac-dee7-4a1e-92ba-07393a531683"
            clientSecret: "H6aSysZWmqLEqvyNP9wfpcx9vSKxc961Xt7hcLORLYHz0uHNKLC1e0VjbdZoyMJ9mWHoQSiAbNSGqXu8UoRj8OTjZG0N1nBsym7QL5KlzeQ8v775eH8EdLl7LU"
            scopes: "openid,profile,email"
            link: '<p>To sign-in using your AAF credentials, please click on the button below.</p><p><a href="/openid-login?providerId=aaf"><img src="/images/aaf_service_223x54.png" /></a></p>'
            shouldFilterEmailDomains: true
            allowedEmailDomains: "uq.edu.au"
            forceUserCreate: true
            userAutoEnabled: true
            userAutoVerified: true
            emailProperty: email
            givenNameProperty: name
            familyNameProperty: deliberately_unknown_property

  probes:
    startup:
      failureThreshold: 30
      periodSeconds: 20
    liveness:
      periodSeconds: 20
    readiness:
      periodSeconds: 20

  timezone: Australia/Brisbane
