{
  "name": "fmriprep-bids",
  "label": "fMRIPrep",
  "description": "Runs fMRIPrep on an XNAT MR session after converting scan-level NIFTI and BIDS sidecar resources to a BIDS layout.",
  "version": "25.2.5-ais.2",
  "schema-version": "1.0",
  "type": "docker",
  "image": "xnat/fmriprep:25.2.5-ais.2",
  "index": "https://index.docker.io/v1/",
  "info-url": "https://fmriprep.org/",
  "command-line": "bash -lc 'set -euo pipefail; mkdir -p /work/home /work/templateflow; fmriprep /input /output participant --skip-bids-validation --notrack --fs-no-reconall --nprocs \"$FMRIPREP_NPROCS\" --omp-nthreads \"$FMRIPREP_OMP_NTHREADS\" --mem \"$FMRIPREP_MEMORY_MB\" -w /work'",
  "working-directory": "/work",
  "override-entrypoint": true,
  "reserve-memory": "8192",
  "limit-memory": "32768",
  "limit-cpu": "8.0",
  "environment-variables": {
    "HOME": "/work/home",
    "MPLCONFIGDIR": "/work/matplotlib",
    "TEMPLATEFLOW_HOME": "/work/templateflow",
    "FMRIPREP_NPROCS": "#NPROCS#",
    "FMRIPREP_OMP_NTHREADS": "#OMP_NTHREADS#",
    "FMRIPREP_MEMORY_MB": "#MEMORY_MB#"
  },
  "mounts": [
    {
      "name": "bids-in",
      "writable": false,
      "path": "/input"
    },
    {
      "name": "fmriprep-out",
      "writable": true,
      "path": "/output"
    },
    {
      "name": "work",
      "writable": true,
      "path": "/work"
    }
  ],
  "inputs": [
    {
      "name": "nprocs",
      "label": "CPU processes",
      "description": "Maximum number of fMRIPrep worker processes.",
      "type": "number",
      "required": true,
      "default-value": "4",
      "replacement-key": "#NPROCS#"
    },
    {
      "name": "omp-nthreads",
      "label": "Threads per process",
      "description": "Maximum number of OpenMP threads used by ANTs and similar tools.",
      "type": "number",
      "required": true,
      "default-value": "2",
      "replacement-key": "#OMP_NTHREADS#"
    },
    {
      "name": "memory-mb",
      "label": "Memory MB",
      "description": "Memory limit fMRIPrep should assume for workflow scheduling.",
      "type": "number",
      "required": true,
      "default-value": "16000",
      "replacement-key": "#MEMORY_MB#"
    }
  ],
  "outputs": [
    {
      "name": "fmriprep-output",
      "description": "fMRIPrep derivatives, reports, logs, and boilerplate.",
      "mount": "fmriprep-out",
      "required": true
    }
  ],
  "xnat": [
    {
      "name": "fmriprep-session",
      "label": "fMRIPrep",
      "description": "Run fMRIPrep on this MR session",
      "contexts": [
        "xnat:mrSessionData"
      ],
      "external-inputs": [
        {
          "name": "session",
          "description": "Input MR session. The session must contain scan-level NIFTI resources and BIDS JSON sidecar resources.",
          "type": "Session",
          "required": true,
          "provides-files-for-command-mount": "bids-in",
          "via-setup-command": "xnat/xnat2bids-setup:1.4:xnat2bids",
          "load-children": false
        }
      ],
      "derived-inputs": [],
      "output-handlers": [
        {
          "name": "fmriprep-resource",
          "accepts-command-output": "fmriprep-output",
          "as-a-child-of": "session",
          "type": "Resource",
          "label": "FMRIPREP"
        }
      ]
    }
  ]
}
