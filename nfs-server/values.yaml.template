# Legacy NFS Server Helm Chart Values
# XNAT/Jupyter use static local PVs now. Keep this chart scaled down by
# default; start it only for emergency access to the old rollback copy.

replicaCount: 0

image:
  repository: itsthenetwork/nfs-server-alpine
  tag: "12"
  pullPolicy: IfNotPresent

# Uncomment to pin NFS server to specific node
#nodeSelector:
#  kubernetes.io/hostname: k3s-node-1

persistence:
  # k3s default storage class is 'local-path'
  storageClass: local-path
  size: 600Gi

# The default nfs-server-alpine startup leaves knfsd at 8 worker threads.
# XNAT and Jupyter are NFS clients on the same node as this in-cluster NFS
# server, so all workers can be exhausted by client writeback/reclaim stalls
# during large uploads. Keep a larger pool available.
nfsdThreads: 32
