# NFS Server Helm Chart Values
# Provides in-cluster NFS server for shared XNAT storage

replicaCount: 1

image:
  repository: itsthenetwork/nfs-server-alpine
  tag: "12"
  pullPolicy: IfNotPresent

# Uncomment to pin NFS server to specific node
#nodeSelector:
#  kubernetes.io/hostname: k3s-node-1

persistence:
  # k3s default storage class is 'local-path'
  storageClass: local-path
  size: 600Gi
