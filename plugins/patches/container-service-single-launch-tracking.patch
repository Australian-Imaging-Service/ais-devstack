+                                // AIS patch: route single launches through the bulklaunch endpoint so they
+                                // get a bulk-launch-id and live progress tracking in the activity panel.
+                                if (!bulkLaunch && $.type(dataToPost[rootElement]) === 'string') {
+                                    dataToPost[rootElement] = [dataToPost[rootElement]];
+                                    launchUrl = bulkLaunchUrl(wrapperId, rootElement,
